# Configuración del entorno - CVW Inventory Monitor
ENV=production
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Cámara
CAMERA_SOURCE_TYPE=webcam
CAMERA_WEBCAM_INDEX=0
# RTSP seguro (no se expone al frontend):
CAMERA_RTSP_URL=

# Modelos
MODEL_CONFIDENCE=0.25
MODEL_IOU=0.45
MODEL_DEVICE=auto

# Alertas
ALERT_EMPTY_THRESHOLD=0.80
ALERT_CONSECUTIVE_SECONDS=3.0
ALERT_COOLDOWN_SECONDS=30.0
ALERT_WEBHOOK_URL=
